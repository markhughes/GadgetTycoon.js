[MISSION0]
COMMENT       = "Titre de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "WC-Wettbewerb"

[MISSION1]
COMMENT       = "Titre de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Gehen Sie es an!"

[MISSION2]
COMMENT       = "Titre de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Abenteuer Osten"

[MISSION3]
COMMENT       = "Titre de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Hyperinflation!"

[MISSION4]
COMMENT       = "Titre de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Börsencrash!"

[MISSION5]
COMMENT       = "Titre de la mission 5"
LAST_MODIFIED = "6/13/2001"
STRING        = "Start-Up vor dem Aus"

[MISSION6]
COMMENT       = "Titre de la mission 6"
LAST_MODIFIED = "6/13/2001"
STRING        = "Das Embargo"

[MISSION7]
COMMENT       = "Titre de la mission 7"
LAST_MODIFIED = "6/13/2001"
STRING        = "Forscherflucht"

[MISSION8]
COMMENT       = "Titre de la mission 8"
LAST_MODIFIED = "6/13/2001"
STRING        = "Mister Clean"


; *****************************************************************************
;
;	MISSION_DESC
;
; *****************************************************************************
[MISSION0_LINE0]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Produkt: Toiletten"

[MISSION0_LINE1]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Schwierigkeitsgrad : Leicht"

[MISSION0_LINE2]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Zielsetzung: Fertigen Sie die fortschrittlichste Toilette."

[MISSION0_LINE3]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Unbegrenzte Zeit"

[MISSION0_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Sehr geehrte Damen und Herren,§§als Direktor der Europäischen Wissenschaftsstiftung ist es mir eine Ehre, Sie zur 4. Internationalen Toilettenmesse einzuladen, die nächstes Jahr um diese Zeit in Kopenhagen stattfindet."

[MISSION0_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Ich bin überzeugt, dass fortschrittliche Hygieneanlagen die Boomtechnologie des neuen Jahrtausends werden, so wie 50 Jahre zuvor die Kernschmelzung und 500 Jahre zuvor das Schießpulver."

[MISSION0_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Als einer der Aussteller werden Sie die Gelegenheit haben, Ihre Projekte einer Reihe von Mitbewerbern vorzustellen und auch deren Neuentwicklungen zu betrachten. "

[MISSION0_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Die beste Toilette erhält ein Preisgeld von $100.000, die zweit- und drittbeste jeweils $20.000. Wir freuen uns schon auf ein Treffen in Kopenhagen!"

[MISSION0_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "§§Mit freundlichen Grüßen§§I . Asimov"

[MISSION0_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""


[MISSION1_LINE0]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Produkt: Toiletten"

[MISSION1_LINE1]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Schwierigkeitsgrad: Schwer"

[MISSION1_LINE2]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Zielsetzung: Verkaufen Sie 400 Toiletten."

[MISSION1_LINE3]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Unbegrenzte Zeit"

[MISSION1_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Als auf Start-Ups spezialisierter Unternehmensberater haben Sie eine Nachricht vom Chef eines WC-Herstellers auf Ihrem Anrufbeantworter, der Hilfe bei der Vermarktung seiner Waren braucht. Können Sie dem Unternehmen helfen, sich finanziell über Wasser zu halten?"

[MISSION1_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "§Mein Name ist Bendicks von U-Bendix and Flush. Sie haben vielleicht noch nie von unseren Produkten gehört, aber ich wette, Sie haben schon des öfteren darauf gesessen. Wir stellen Toiletten her, müssen Sie wissen. Futuristische Toiletten. Allerdings sieht die Zukunft nicht allzu gut aus für uns. Daher rufe ich an."

[MISSION1_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "§Das Problem ist - wir finden keine Käufer. Irgendwie scheinen sie nicht gerne über die Zukunftsaussichten zu reden, die wir ihnen bieten. Verstellbare Sitze und medizinische Analysen.  Wenn's nach denen ginge, hätten wir wahrscheinlich immer noch Plumpsklos. Unsere Personalplanung sagt, dass es auch nicht genügend Techniker und Aufseher gibt, daher tröpfelt die Produktion nur so vor sich hin."

[MISSION1_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Und die Leute verlangen ein horrendes Gehalt für jede kleinste Anstrengung. Ich habe versucht, mit der Personalplanung darüber zu sprechen, aber im Grunde reden wir eigentlich gar nicht miteinander. Ehrlich gesagt, komme ich auch nicht allzu gut mit der Forschungsabteilung aus - sie liefern einfach nichts."

[MISSION1_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Keine Patente, keine Lizenzgebühren. Auf gut Deutsch gesagt, die Arbeitsatmosphäre ist beschissen! Wenn die Leute etwas kooperativer wären, würde ich ihnen ja auch mehr zahlen zumindest, wenn ich es mir leisten könnte. "

[MISSION1_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Aber wir haben so gut wie nichts mehr auf Lager, und selbst das, was wir verkaufen, bringt nicht genug Lizenzgebühren. Ich habe keine Ahnung, was schief gelaufen ist! Können Sie sich ein Bild von meiner Lage machen? Ich dachte, bevor ich endgültig das Handtuch werfe, wende ich mich an Sie. Vielleicht haben Sie ja ein besseres Händchen."


[MISSION2_LINE0]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Produkt: Rollschuhe"

[MISSION2_LINE1]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Schwierigkeitsgrad: Leicht"

[MISSION2_LINE2]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Zielsetzung: Erhöhen Sie Ihr Guthaben auf $10.000.000"

[MISSION2_LINE3]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Unbegrenzte Zeit"

[MISSION2_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Sie dachten also, die Dinge könnten nicht schlechter laufen? Tja, da haben Sie sich wohl getäuscht. Ihr kleiner Bruder, der noch nie das Superhirn der Familie war, hatte gerade die tolle Idee, seine gesamte Erbschaft in eine heruntergekommene, ehemals staatliche Rollschuhfabrik im Osten zu investieren, die natürlich rote Zahlen schreibt."

[MISSION2_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Ehemaliges Sowjetgebiet, jetzt eine Demokratie. Im Land herrscht Inflation, die Bevölkerung sieht ihren Lebensstandard gen null sinken und diejenigen, die es sich leisten können, verschwinden in den Westen."

[MISSION2_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Die demoralisierten und meist ungelernten Arbeitskräfte, die noch im Land sind, verlangen zwar nicht viel, sind dafür aber auch keine große Bereicherung. Durch die Privatisierung der Banken wurde eine finanzielle Kluft aufgerissen, die jetzt die Mafia füllt."

[MISSION2_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Die Zeiten, da nur eine Partei das Sagen hatte, sind zwar endgültig vorbei, doch es gibt weiterhin das riesige, mit Staatsgeldern gefütterte Gosudarstvenny Rollschuhinstitut, das noch bis vor kurzem eine Monopolstellung für Produktion und Entwicklung hatte und diese auch nicht unbedingt abgeben will."

[MISSION2_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Und die Angestellten des Instituts halten ihren Arbeitsplatz dort für weitaus sicherer als bei ihrem kleinen kapitalistischen West-Unternehmen. Also - um der Familienehre willen - bringen Sie den Laden wieder in Schwung! "

[MISSION2_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Mit zehn Milliönchen wäre Ihrem Bruder sicher schon geholfen und er könnte endlich das Internet-Start-Up in Silicon Valley aufziehen, wie Sie es ihm eigentlich geraten hatten."


[MISSION3_LINE0]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Produkt: Roboter-Haushaltshilfe"

[MISSION3_LINE1]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Schwierigkeitsgrad: Schwer"

[MISSION3_LINE2]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Zielsetzung: Halten Sie länger durch als die anderen"

[MISSION3_LINE3]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Unbegrenzte Zeit"

[MISSION3_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Die Phase der geringen Inflation und hohen Steuerbelastung scheint langsam zu Ende zu gehen. Die Weltwirtschaft geht bergab, die Regierungen senken verzweifelt die Steuern und Zinssätze, um die Wirtschaft ihres Landes wieder anzukurbeln."

[MISSION3_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Das Ausmaß der daraus entstehenden Inflation jedoch hatte niemand vorausgesehen. Und was noch schlimmer ist - eine Marktstudie hat ergeben, dass der vorausgesagte Hygiene-Boom nicht eingesetzt hat."

[MISSION3_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Der Öffentlichkeit ist es immer noch unangenehm sich mit ihren Körperfunktionen auseinanderzusetzen. Sie bleibt lieber auf dem Stand des 19. Jahrhunderts."

[MISSION3_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Allerdings zeigt die Studie auch, dass der Grund für den Misserfolg nicht allein die Verklemmtheit ist, sondern auch die Tatsache, dass die Kundschaft aufgrund der vielen verschiedenen Modelle auf dem Markt einfach verwirrt ist. "

[MISSION3_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Eigentlich kein Wunder, wenn man bedenkt, dass neben Ihnen noch sieben andere Unternehmen um ihr Überleben kämpfen. ?"

[MISSION3_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Und da die Kaufpreise sich immer mehr in die Höhe schrauben, wird dieser Überlebenskampf wohl so einige Opfer fordern. Können Sie den Sturm überstehen und einer der Spieler sein, der noch immer dabei ist, wenn sich die Wogen gelegt haben"


[MISSION4_LINE0]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Produkt: Rollschuhe"

[MISSION4_LINE1]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Schwierigkeitsgrad: Schwer"

[MISSION4_LINE2]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Zielsetzung: Überleben Sie bis zu letzt und halten Sie so lange wie möglich durch!"

[MISSION4_LINE3]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Begrenzte Zeit"

[MISSION4_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Die Frage ist hier nicht, ob Sie bankrott gehen: Sie haben definitiv verloren. Nicht nur, dass die Inflation die Preise völlig außer Kontrolle setzt: Ihre Investoren, die einst so großzügig und wohlwollend waren, versuchen nur noch, ihren eigenen Schaden zu begrenzen."

[MISSION4_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Sie werden Sie ausbluten lassen. Sie müssen täglich Konventionalstrafen zahlen, die immer höher werden."

[MISSION4_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Allein für Ihre Würde beschließen Sie, es als letzte Firma auf dem sinkenden Schiff des Marktes auszuhalten, bevor Sie endgültig aufgeben."

[MISSION4_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Sie wollen bis zum bitteren Ende durchhalten."

[MISSION4_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""

[MISSION4_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""

[MISSION5_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Produkt:  Toiletten"

[MISSION5_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Schwierigkeitsgrad: Leicht"

[MISSION5_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Zielsetzung: Bringen Sie Ihr Unternehmen aus den roten Zahlen."

[MISSION5_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Begrenzte Zeit"

[MISSION5_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sie werden in einem Start-Up-Unternehmen eingesetzt, das schwer verschuldet ist und droht, bankrott zu gehen. Die Strategie Ihres Vorgängers war katastrophal - er hat das gesamte Geld in Forschung investiert."

[MISSION5_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sie haben jetzt ein hypermodernes Forschungslabor und jede Technologie erforscht, Ihre Forscher sind die Besten der Besten und kaum bezahlbar."

[MISSION5_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Mit anderen Worten - extrem hohe Ausgaben und keine Rentabilität."

[MISSION5_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§Die Investoren erwarten, dass Sie innerhalb von einem Jahr das Ruder herumreißen."

[MISSION5_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION5_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "



[MISSION6_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Produkt: Rollschuhe"

[MISSION6_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Schwierigkeitsgrad: Mittel"

[MISSION6_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Zielsetzung: Erwirtschaften Sie ein Guthaben von 2.500.000$."

[MISSION6_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Unbegrenzte Zeit"

[MISSION6_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sie haben sich geweigert, Schmiergeld ans Finanzministerium zu zahlen. Daher macht die Regierung jetzt ihre Drohung wahr: ein Produktembargo."

[MISSION6_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sie können überhaupt nichts verkaufen. Und als ob das noch nicht genug wäre, nutzt die Konkurrenz Ihre Lage auch noch aus, um Sie für immer aus dem Markt zu drängen."

[MISSION6_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Dabei ist ihr jedes Mittel recht: Sie haben es jetzt täglich mit Spionage und Einschüchterungsversuchen zu tun. Versuchen Sie erst gar nicht, einen Rechtsanwalt einzuschalten."

[MISSION6_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Die würden jetzt sowieso nicht für Sie arbeiten."

[MISSION6_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§Ihre einzige Chance besteht darin, die gelegentlichen Produktions- und Forschungsaufträge ausländischer Unternehmen anzunehmen. Machen Sie so viel Geld wie möglich - und wenn Sie gut da stehen, steigen Sie aus."

[MISSION6_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION7_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Produkt: Toiletten"

[MISSION7_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Schwierigkeitsgrad: Mittel"

[MISSION7_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Zielsetzung: Ihr Produkt muss eine 60%-Wertung von den Design-Fans erhalten."

[MISSION7_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Unbegrenzte Zeit"

[MISSION7_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "All Ihre Forscher haben die Firma verlassen, nur noch die Techniker sind Ihnen geblieben." 

[MISSION7_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Trotz alledem haben Sie sich entschieden, Ihrer Firma treu zu bleiben und sich dem Kampf mit den geheimen Forschungslaboren zu stellen, denen Mittel im Überfluss zur Verfügung stehen."

[MISSION7_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sie sind überzeugt, dass Sie einen Markt finden werden -"

[MISSION7_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sie müssen sich nur richtig positionieren und dann zuschlagen."

[MISSION7_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION7_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION8_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Produkt: Roboter-Haushaltshilfen"

[MISSION8_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Schwierigkeitsgrad: Mittel"

[MISSION8_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Zielsetzung: Halten Sie Ihr Unternehmen am längsten am Leben."

[MISSION8_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Unbegrenzte Zeit"

[MISSION8_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sie sind Mister Clean."

[MISSION8_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§Und als wahrer Gentleman verachten Sie Ihre Rivalen, die sich zusammengetan haben, um Sie mit allen erdenklichen Mitteln aus dem Verkehr zu ziehen."

[MISSION8_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Um sich nicht mit ihnen auf dieselbe Stufe zu stellen, beschließen Sie, sich in Form einer Klage zu wehren. Das Problem ist nur, den Schuldigen zu finden."

[MISSION8_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Wenn Sie einen unschuldigen Rivalen in einen Prozess verwickeln, haben Sie verloren. Gelingt es Ihnen jedoch, den Richtigen anzuklagen, wird das Strafmaß so hoch sein, dass er aufgeben muss."

[MISSION8_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Halten Sie durch und schalten Sie die Konkurrenz nach und nach aus."

[MISSION8_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

