[VICTORY1]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Erhöhen Sie Ihr Guthaben auf $5.000.000."

[VICTORY2]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Erhöhen Sie Ihren Aktienkurs auf $700."

[VICTORY3]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Verkaufen Sie 300 Einheiten an Technik-Fans."

[VICTORY4]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Verkaufen Sie 300 Einheiten an Design-Fans."

[VICTORY5]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Bringen Sie Ihre Forschungsprojekte in 2 Jahren so weit wie möglich voran"

[VICTORY6]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Gewinnen Sie soviel Geld wie möglich in 2 Jahren"

[VICTORY7]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Erreichen Sie den höchsten Aktienkurs nach 2 Jahren"

[VICTORY8]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Erreichen Sie den höchten Marktanteil bei Technik-Fans nach 2 Jahren"

[VICTORY9]
COMMENT="Conditions de victoire"
LAST_MODIFIED="1/10/2000"
STRING="Erreichen Sie den höchten Marktanteil bei Design-Fans nach 2 Jahren"

[VICTORY10]
COMMENT       = "Conditions de victoire"
LAST_MODIFIED = "25/04/2001"
STRING        = "Gewinnen Sie soviel Geld wie möglich in 30 Min."


; *****************************************************************************
;
;	SYSTEM
;
