[{"name":"0","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",140],["LAST_FRAME",200],["STRING","Leg los, hau rein,"]]},{"name":"1","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",210],["LAST_FRAME",300],["STRING","Und lass die Uni Uni sein,"]]},{"name":"2","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",350],["LAST_FRAME",500],["STRING","Zieh dein Leben aus dem Sumpf, wo die Noten dich versenken."]]},{"name":"3","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",550],["LAST_FRAME",700],["STRING","Vier Jahre lang hast du's vermasselt, zu viel gesoffen, zu viel gequasselt."]]},{"name":"4","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",750],["LAST_FRAME",900],["STRING","Statt an Dante und Descartes zu denken."]]},{"name":"5","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",950],["LAST_FRAME",1000],["STRING","Jetzt musst du dich wohl selber retten."]]},{"name":"6","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1050],["LAST_FRAME",1110],["STRING","Du hast den Plan, das Produkt, ja ein Projekt?"]]},{"name":"7","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1120],["LAST_FRAME",1200],["STRING","Vielleicht ist's Mist, doch so lang das keiner checkt,"]]},{"name":"8","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1201],["LAST_FRAME",1280],["STRING","Verkauf Roboter, Rollschuh, Fernseher und Toiletten."]]},{"name":"9","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1280],["LAST_FRAME",1345],["STRING","Und droht dann mal dein Gewissen zu erweichen,"]]},{"name":"10","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1350],["LAST_FRAME",1400],["STRING","So ist selbst das ein wundervolles Zeichen."]]},{"name":"11","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1401],["LAST_FRAME",1470],["STRING","An der Uni kriegst du stets naiv-gelehrte Deppen"]]},{"name":"12","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1475],["LAST_FRAME",1550],["STRING","Die kannst du für dein vieles Wissen mit noch weniger entlohnen."]]},{"name":"13","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1551],["LAST_FRAME",1650],["STRING","Werden die dann wirklich mürrisch und wollen mehr"]]},{"name":"14","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1651],["LAST_FRAME",1700],["STRING","Gib halt Aktienoptionen"]]},{"name":"15","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1701],["LAST_FRAME",1760],["STRING","Für dein neues Unternehmen her."]]},{"name":"16","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1761],["LAST_FRAME",1840],["STRING","Plag dann die Investoren und lade sie fein"]]},{"name":"17","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1841],["LAST_FRAME",1910],["STRING","Zur Party in die Firma ein."]]},{"name":"18","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",1911],["LAST_FRAME",2000],["STRING","Frag deine Familie, Freunde, Finanz- und Mafiavertreter."]]},{"name":"19","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",2001],["LAST_FRAME",2070],["STRING","Tu alles, werde zum Verräter"]]},{"name":"20","entries":[["LAST_MODIFIED","1/10/2000"],["FIRST_FRAME",2071],["LAST_FRAME",2150],["STRING","Um von ihnen allen Geld zu borgen."]]}]