[11]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1401
LAST_FRAME=1470
STRING="Neem jonge broekies in dienst, die je trots hun kersverse schooldiploma tonen."

[12]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1475
LAST_FRAME=1550
