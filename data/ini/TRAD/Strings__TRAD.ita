STRING        = "Mister Onestà"

; *****************************************************************************
;
;	MISSION_DESC
;
; *****************************************************************************
[MISSION0_LINE0]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Prodotto: Water"

[MISSION0_LINE1]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Livello: Facile"

[MISSION0_LINE2]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Obiettivo: Produrre il water più sofisticato"

[MISSION0_LINE3]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Tempo illimitato"

[MISSION0_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Egregio Signore,§§Quale segretario della Fondazione Scientifica Europea ho il privilegio di invitarLa alla 4° Fiera Internazionale del Water, che si terrà l'anno prossimo in questo periodo a Copenaghen."

[MISSION0_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "È mia sincera speranza che le Attrezzature Tecnologiche da Bagno saranno il punto di svolta tecnologico del millennio, così come la fusione nucleare lo è stata cinquant'anni fa e la polvere da sparo cinque secoli fa."

[MISSION0_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Partecipando alla fiera avrà la possibilità di presentare i suoi prodotti a un gruppo di operatori del mercato e di osservare il lavoro di altre aziende attive nel settore."

[MISSION0_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Al migliore water andrà un premio di 100.000 dollari, con due premi da 20.000 dollari ciascuno ai secondi classificati."

[MISSION0_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "In attesa di incontrarla a Copenaghen,§§Le porgo i miei migliori saluti,§§I. Asimov"

[MISSION0_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""


[MISSION1_LINE0]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Prodotto: Water"

[MISSION1_LINE1]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Livello: Difficile"

[MISSION1_LINE2]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Obiettivo: Vendere 400 water"

[MISSION1_LINE3]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Tempo illimitato"

[MISSION1_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Come consulente specializzato in aziende in crescita, ricevi un messaggio sulla segreteria telefonica da parte del direttore di un'azienda produttrice di water che sta lottando per portare sul mercato i propri prodotti."

[MISSION1_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Sei in grado di riportare a galla le sue fortune?§§"Mi chiamo Dell'Acqua, di Dell'Acqua e Sciacquoni. Forse non ci ha mai sentito nominare, ma scommetto che si è seduto sul nostro prodotto. Infatti, noi produciamo water. Water futuribili. Il futuro, però, non è roseo. Per questo ci rivolgiamo a lei."

[MISSION1_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "§Il problema è che nessuno compra. Molti sembrano imbarazzati nel parlare del grande futuro che offriamo con i nostri prodotti, come sedili regolabili e analisi mediche. Sembra che tutti si accontentino di gabinetti antidiluviani."

[MISSION1_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Ho parlato con i responsabili del personale e dicono che mancano anche tecnici e supervisori, perciò la produzione sta calando e pretendono un sacco di soldi per ogni minimo sforzo. Ho provato a discuterne con i responsabili del personale, ma ci parliamo a malapena."

[MISSION1_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "In realtà ho qualche difficoltà anche con il settore ricerca e sviluppo: non combinano niente. Niente brevetti, niente royalty. Ah, l'atmosfera qui è davvero pesante! Darei loro anche qualche aumento, se fossero più disponibili - o se potessi permettermelo."

[MISSION1_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Il flusso di magazzino però si sta esaurendo e anche vendendo le scorte non otterremmo i guadagni che ci occorrono.  Accidenti, non capisco dove ho sbagliato!  Si è fatto un'idea?  Vorrei affidare la cosa a lei, prima di gettare la spugna.  Spero che lei riesca a cavarsela meglio di me.”"


[MISSION2_LINE0]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Prodotto: Pattini a rotelle"

[MISSION2_LINE1]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Livello: Facile"

[MISSION2_LINE2]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Obiettivo: Raggiungere un bilancio finanziario di 10.000.000 di dollari"

[MISSION2_LINE3]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Tempo illimitato"

[MISSION2_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Se credevi che le cose andassero male, purtroppo stanno per andare anche peggio."

[MISSION2_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Il tuo fratellino, che non è mai stato il cervello della famiglia, ha avuto la brillante idea di sperperare la sua intera eredità acquistando una fabbrica di pattini a rotelle in perdita, in passato di proprietà statale, in un'instabile democrazia orientale dell'ex-blocco sovietico."

[MISSION2_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Il paese è stretto nella morsa dell'inflazione e i dipendenti, pagati poco e scarsamente produttivi, hanno visto il proprio standard di vita declinare mentre i loro colleghi più qualificati si sono trasferiti in occidente." 

[MISSION2_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "La privatizzazione del sistema bancario ha lasciato un vuoto finanziario che la mafia non ha esitato a riempire. E non è questo il peggio. I tempi del partito unico saranno anche finiti, ma il colossale e improduttivo Istituto dei Pattini Gosudarstvenny deteneva fino a poco tempo fa il monopolio totale sulla produzione e la ricerca. 

[MISSION2_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Tuttora fortemente sostenuto dal governo, è ovviamente tutt'altro che disposto a rinunciarvi. I suoi dipendenti, inoltre, non sono molto ansiosi di cambiare musica, dal momento che la fabbrica, malgrado i suoi difetti, garantisce comunque un livello di sicurezza molto più attraente del tuo cinico capitalismo occidentale."

[MISSION2_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Per l'onore della famiglia, dovrai risolvere questo pasticcio e guadagnare dieci bei milioni di dollari per il tuo fratellino, che potrà finalmente creare un'impresa legata a Internet nella Silicon Valley come gli avevi consigliato tu."


[MISSION3_LINE0]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Prodotto: Androidi per i lavori domestici"

[MISSION3_LINE1]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Livello: Difficile"

[MISSION3_LINE2]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Essere l'ultimo giocatore sopravvissuto e tenere duro il più a lungo possibile"

[MISSION3_LINE3]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Tempo illimitato"

[MISSION3_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Non ci sono dubbi sul fatto che sei destinato al fallimento: la tua è una causa persa." 

[MISSION3_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Non solo la super-inflazione ha determinato un continuo crollo dei prezzi al di fuori di qualsiasi controllo, ma i tuoi investitori, prima così fiduciosi e generosi, hanno avviato una strategia di limitazione dei danni."

[MISSION3_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = " Ti spremeranno come un limone. Le penali che devi pagare ogni giorno aumentano continuamente."

[MISSION3_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Per mantenere intatta la tua dignità, decidi che la tua azienda sarà l'ultima a fare fagotto e che terrai duro il più a lungo possibile."

[MISSION3_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""

[MISSION3_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""


[MISSION4_LINE0]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Prodotto: Pattini a rotelle"

[MISSION4_LINE1]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Livello: Difficile"

[MISSION4_LINE2]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Obiettivo: Avere la massima disponibilità finanziaria quando il mercato crolla"

[MISSION4_LINE3]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Tempo limitato

[MISSION4_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Il mercato è andato a gonfie vele per troppo tempo. Solo gli ingenui possono credere che durerà per sempre: quando mai al 'boom' non è seguito il 'crac'?"

[MISSION4_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Il boom in corso è stato senz'altro impressionante e tutto indica che il relativo crollo sarà altrettanto spettacolare."

[MISSION4_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Insomma, la crisi è prossima. Qualsiasi analista può confermarlo. Il problema è: quando? E quanto tempo c'è per arricchirsi su ciò che resta?"

[MISSION4_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Il vincitore sarà chi riuscirà a disporre del capitale maggiore quando il mercato andrà a gambe all'aria."

[MISSION4_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""

[MISSION4_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""

[MISSION5_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Prodotto:  Water"

[MISSION5_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Livello: Facile"

[MISSION5_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Obiettivo: Uscire dal passivo portando il bilancio in pari"

[MISSION5_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tempo limitato"

[MISSION5_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sei stato inviato presso un'azienda in fase di sviluppo che sta per colare a picco ed è fortemente indebitata."

[MISSION5_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "La strategia del tuo predecessore è stata disastrosa. Ha investito tutto nella ricerca."

[MISSION5_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Hai a disposizione un laboratorio all'avanguardia e hai ricercato tutte le tecnologie possibili."

[MISSION5_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Hai ricercatrici esperte ma molto costose. Le spese sono enormi e i profitti inesistenti. Gli investitori vogliono che tu risolva la situazione entro un anno "

[MISSION5_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION5_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "



[MISSION6_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Prodotto: Pattini a rotelle"

[MISSION6_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Livello: Medio"

[MISSION6_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Obiettivo: Raggiungere 2.500.000 di dollari di attivo"

[MISSION6_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tempo illimitato"

[MISSION6_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Non hai pagato le bustarelle al Ministro delle Finanze e il governo ha messo in atto le sue minacce: un embargo sui tuoi prodotti. Non puoi vendere nulla."

[MISSION6_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Quel che è peggio è che il tuo concorrente sta approfittando della splendida occasione per toglierti di mezzo definitivamente. Non si ferma davanti a nulla: spionaggio e intimidazione sono due dei tuoi impegni di lavoro quotidiani."

[MISSION6_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Non puoi aspettarti aiuto dalla legge, inoltre, perché in questo paese gli avvocati sono corrotti fino al midollo e comunque nessuno di loro sarebbe disposto a lavorare per te."

[MISSION6_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "L'unico modo per sopravvivere consiste nello sfruttare gli occasionali ordini di produzione e ricerca che ricevi da imprese straniere. Accumula più denaro che puoi e taglia la corda finché sei in tempo."

[MISSION6_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION6_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION7_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Prodotto: Water"

[MISSION7_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Livello: Medio"

[MISSION7_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Obiettivo: Fare in modo che il prodotto ottenga un giudizio di 60% da parte degli emotivi"

[MISSION7_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tempo illimitato"

[MISSION7_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "C'è stata una fuga di cervelli. Ti restano solo i tecnici."

[MISSION7_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Malgrado tutto, hai deciso di rimanere al tuo posto in azienda e di competere con laboratori di ricerca segreti in possesso di tutte le risorse necessarie."

[MISSION7_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sei certo di riuscire a trovare un mercato:"

[MISSION7_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "a te il compito di posizionare correttamente il tuo prodotto e di fare centro."

[MISSION7_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION7_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION8_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Prodotto: Androidi domestici"

[MISSION8_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Livello: Medio"

[MISSION8_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Obiettivo: Essere l'ultimo giocatore sopravvissuto"

[MISSION8_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tempo illimitato"

[MISSION8_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Sei Mister Onestà. Da vero gentiluomo, disprezzi i tuoi concorrenti che hanno unito le proprie forze per distruggere la tua impresa con i mezzi più sporchi."

[MISSION8_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Deciso a non abbassarti al loro livello, ti rivolgi ai tuoi legali e intenti numerose cause."

[MISSION8_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Il problema è individuare il vero colpevole: se porterai in tribunale un concorrente innocente,  perderai la causa."

[MISSION8_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Se invece riuscirai a pescare il colpevole, la multa che dovrà pagare sarà talmente alta da metterlo in ginocchio. Tieni testa ai vergognosi attacchi dei concorrenti e consegnali alla giustizia uno dopo l'altro."

[MISSION8_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION8_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

