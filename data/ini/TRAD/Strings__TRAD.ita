[MISSION1]
COMMENT       = "Titre de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Come cavarsela?"

[MISSION2]
COMMENT       = "Titre de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Si va a est"

[MISSION3]
COMMENT       = "Titre de la mission 3"
