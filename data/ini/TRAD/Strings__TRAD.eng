; *****************************************************************************
;
;	MISSION_DESC
;
; *****************************************************************************
[MISSION0_LINE0]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Latrines"

[MISSION0_LINE1]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Level: Easy"

[MISSION0_LINE2]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objective: Produce the most sophisticated latrine"

[MISSION0_LINE3]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Limited time"

[MISSION0_LINE4]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "As secretary of the European Science Foundation it is my privilege to invite you to participate in the 4th International Latrine Fair which will be held this time next year in Copenhagen."

[MISSION0_LINE5]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "It is my sincere hope that En-suite Privy Facilities will be our nascent millennium’s transforming technology, in the same way that nuclear fusion was fifty years ago, and gunpowder was five hundred years ago. "

[MISSION0_LINE6]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "As a participant in the fair you will have the opportunity to display your work to a panel of competitors, and observe the work of other companies active in the field.  A prize of $100,000 will be awarded for the best latrine, followed by two runner-up prizes of $20,000 each. "

[MISSION0_LINE7]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "We look forward to seeing you in Copenhagen,"

[MISSION0_LINE8]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "Yours sincerely,""

[MISSION0_LINE9]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "I. Asimov"

[MISSION1_LINE0]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Latrines"

[MISSION1_LINE1]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Level: Difficult"

[MISSION1_LINE2]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objective: Reach sales of 400 latrines"

[MISSION1_LINE3]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Unlimited time"

[MISSION1_LINE4]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "As a management consultant specialising in start-ups, you receive a message on your answering machine from the boss of a toilet manufacturer, who are struggling to push their goods out onto the market.  Can you bring their fortunes back to the watermark ?"

[MISSION1_LINE5]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "§' My name’s Bendicks of U-Bendix and Flush.  You might not have heard of us but I bet you’ve sat on us once in a while.  You see, we do toilets.  Futuristic.  But the future ain’t bright."

[MISSION1_LINE6]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "That’s why we’re calling you.§The problem is - no-one’s buying.  They’re embarrassed to talk about the bright new future we’re offering.  Adjustable seats and  medical sampling.  I guess they’re happy to lock themselves in the dark ages of ball-cock and scale build-up. "

[MISSION1_LINE7]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "I talked to HR and they say there ain’t no technicians or supervisors either, so production’s running dry and they want top dollar for every effort they make. Well, I tried to talk to HR but we’re barely on speaking terms. "

[MISSION1_LINE8]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "In fact, I’m not getting on too well with R and D either: they’re not delivering the goods.  No patents, no royalties.  Hell, the atmosphere here just stinks!"

[MISSION1_LINE9]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = " I’d give them a raise if they loosened up - or if I could afford it.  But we’ve hardly any stock left to float, and even if we do sell it, it won’t bring us the royalties we need.  Hell, I don’t know what went wrong !  You get the picture ?  I thought I’d hand over to you before I threw in the towel.  I hope you cope with the strain better than I did. '"


[MISSION2_LINE0]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Roller Blades"

[MISSION2_LINE1]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Level: Easy"

[MISSION2_LINE2]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objective: Reach a cash balance of 10.000.000$"

[MISSION2_LINE3]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Unlimited time"

[MISSION2_LINE4]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "So, you thought things were bad, well I’m afraid they’re just about to get a lot worse."

[MISSION2_LINE5]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "Your little brother, who never was the brains of the family, has just had the bright idea of blowing his entire inheritance on a run down, formerly state-owned, loss-making roller blades factory in an unstable, Eastern bloc, ex-Soviet fledgling democracy."

[MISSION2_LINE6]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "As inflation grips the country, a demoralized and underskilled workforce, asking for little and contributing less, has watched their standard of living decline as their better-qualified counterparts move West. The privatization of the banking sector has left a financial gap only the mafia has rushed to fill."

[MISSION2_LINE7]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "And that’s not the worst of it. The party may be over for the one-party state, but the vast unwieldy Gosudarstvenny Rollers Institut has until recently held a total monopoly on production and research."

[MISSION2_LINE8]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "Still heavily subsidized by the government, it is understandably unkeen to relinquish it. And its employees aren’t too quick to rock the boat either since, for all its faults, the factory still provides a degree of security far more attractive than your cynical brand of Western capitalism."

[MISSION2_LINE9]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "For the sake of the family honor, sort this mess out and make a crisp ten million on your brother’s behalf. Then he can go and set up that Internet Start-up in Silicon Valley like you told him to."


[MISSION3_LINE0]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Androïds Home Help"

[MISSION3_LINE1]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Level: Difficult"

[MISSION3_LINE2]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objective: Be the last surviving player"

[MISSION3_LINE3]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Unlimited time"


[MISSION3_LINE4]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "It is not a question of whether you are going to go bankrupt: yours is a lost cause."

[MISSION3_LINE5]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "Not only has hyperinflation sent prices spiraling out of control, but your investors, once so confident and generous, have embarked on a damage limitation exercise."

[MISSION3_LINE6]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "They are going to bleed you dry. You have to pay daily penalties which are constantly being raised."  

[MISSION3_LINE7]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "To keep your dignity intact, you resolve to be the last company to pack up and go home, and hang on as long as possible."

[MISSION3_LINE8]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = " "

[MISSION3_LINE9]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = " "




[MISSION4_LINE0]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Roller Blades"

[MISSION4_LINE1]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Level: Difficult"

[MISSION4_LINE2]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objective: To have the highest bottom line when the market crashes"

[MISSION4_LINE3]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Limited time"

[MISSION4_LINE4]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = "The markets have been sky-high for too long. No-one but the most naïve think it can last forever: whoever heard of ‘boom’ without ‘bust’?" 

[MISSION4_LINE5]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = "Certainly this baby’s boom has been very impressive indeed, and all the signs are her bust is gonna be just as spectacular. She’s gonna crash, and soon." 

[MISSION4_LINE6]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = "Every two-bit analyst can tell you that. The problem is, when? And how much time is there left to cash in on what remains?"

[MISSION4_LINE7]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = "The winner in this game will be the one who has the most money when everything goes belly-up"

[MISSION4_LINE8]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = " "

[MISSION4_LINE9]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = " "


[MISSION5_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Latrines"

[MISSION5_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Level: Easy"

[MISSION5_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objective: Get out of the red by raising your bottom line up to 0"

[MISSION5_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Limited Time"

[MISSION5_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "You have been sent to a start-up which is about to go down the tubes and deeply in debt. Your predecessor’s strategy was disastrous."

[MISSION5_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "He invested everything in research. You have a state-of-the-art lab and have researched every technology." 

[MISSION5_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "You have expert researchers who are very expensive."

[MISSION5_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Colossal outgoings, and no profitability. "



[MISSION5_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§The investors want results and are giving you a year to turn the place around."

[MISSION5_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "



[MISSION6_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Roller Blades"

[MISSION6_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Level: Average"

[MISSION6_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objective: Reach a cash balance of 2.500.000$"

[MISSION6_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Unlimited time"

[MISSION6_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "You haven’t been paying your backhanders to the Finance Ministry, so the government has carried out its threat: a product embargo. You can’t sell anything."

[MISSION6_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "To make things worse, your rival is taking this splendid opportunity to put you out of the picture for good."

[MISSION6_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§Nothing is beneath him: espionage and intimidation are part of your daily routine."

[MISSION6_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "And don’t count on the law to help you, because in this country, the lawyers are rotten to the core and none of them would work for you anyway."

[MISSION6_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§The only way to survive is to fill the occasional production and research orders you receive from foreign companies. Make as much money as you can, and get out while the going’s good."

[MISSION6_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION7_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Latrines"

[MISSION7_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Level: Average"

[MISSION7_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objective: Reach a product rating of 60% by the emotives"

[MISSION7_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Unlimited time"

[MISSION7_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "There’s been a brain drain."

[MISSION7_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "You only have technicians left."

[MISSION7_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Despite everything, you have decided to stay with your company and compete with the secret research labs who have all the resources they need."

[MISSION7_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "You are convinced that you’ll find a market: it’s up to you to position yourself correctly and make a killing."

[MISSION7_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION7_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION8_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Androïds Home Help"

[MISSION8_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Level: Average"

[MISSION8_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objective: Be the last surviving player"

[MISSION8_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Unlimited time"

[MISSION8_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "You are Mister Clean."


[MISSION8_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§As you are quite the gentleman, you despise your rivals, who have joined forces to scupper your firm by fair means or foul, and they are mostly foul."

[MISSION8_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Not to stoop to their level, you decide to call on the services of the legal profession, and launch repeated court actions. The problem is finding the guilty party, because if you sue an innocent rival, you lose."

[MISSION8_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "If you do nab the culprit, however, the fine will be so high he will be forced to throw his hand in. Hold out against the cowardly attacks of the competition and have them convicted one by one."

[MISSION8_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION8_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

