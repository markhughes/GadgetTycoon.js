[MISSION0_LINE0]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Producto: Retretes"

[MISSION0_LINE1]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Nivel: Fácil"

[MISSION0_LINE2]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objetivo: Fabricar el retrete más sofisticado"

[MISSION0_LINE3]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Sin límite de tiempo"

[MISSION0_LINE4]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "Muy Señor mío, §§Como secretario de la Fundación Europea para la Ciencia, es un auténtico honor para mí invitarle a participar en la 4ª Feria Internacional de Retretes que se celebrará el año próximo en Copenhague."

[MISSION0_LINE5]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "Tengo la sincera esperanza de que En-suite Privy Facilities se convertirá en nuestra tecnología de transformación del milenio de la misma forma que la fusión nuclear lo fue hace cincuenta años y la pólvora hace 100 años."

[MISSION0_LINE6]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "Como participante en la feria tendrá la oportunidad de mostrar su obra a todo un plantel de competidores y observar a su vez el trabajo de otras empresas activas del mismo campo."

[MISSION0_LINE7]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "Habrá un premio de 100.000$ para el mejor retrete, seguido de dos segundos premios de 20.000$ cada uno. Esperamos verle en Copenhague, §§Atentamente, §§ I. Asimov."

[MISSION0_LINE8]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = "I. Asimov"

[MISSION0_LINE9]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "5/5/2001"
STRING        = " "



[MISSION1_LINE0]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Producto: Retretes"

[MISSION1_LINE1]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Nivel: Difícil"

[MISSION1_LINE2]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objetivo: Conseguir vender 400 retretes"

[MISSION1_LINE3]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Sin límite de tiempo"

[MISSION1_LINE4]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "Como asesor de dirección especializado en la puesta en marcha de empresas, recibes un mensaje en tu contestador del gerente de una empresa dedicada a la fabricación de inodoros empeñado en sacar sus productos al mercado ¿Podrás poner a flote su capital? §§"Soy Bendicks de U-Bendix and Flush."

[MISSION1_LINE5]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "Tal vez no haya oído hablar de nosotros, pero puedo asegurarle que en algún momento se habrá sentado sobre alguno de nuestros productos. Como puede imaginar, nos dedicamos a la fabricación de retretes. Futuristas. Pero el futuro no es muy brillante. Por eso hemos acudido a usted."

[MISSION1_LINE6]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "§El problema es que nadie compra. A la gente le resulta embarazoso hablar del brillante futuro que ofrecemos. Asientos regulables y toma de muestras médicas. Supongo que estarán encantados de quedarse anclados en los viejos tiempos del flotador y la acumulación de óxido."

[MISSION1_LINE7]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "He hablado con el departamento de RH y me dicen que no hay técnicos, ni tampoco supervisores, así que la producción se agota y quieren que se les pague sueldos astronómicos por cada esfuerzo que hacen. He tratado de hablar con el departamento de RH, pero me temo que nuestras relaciones no atraviesan el mejor momento."

[MISSION1_LINE8]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "De hecho, tampoco es que me lleve demasiado bien con el departamento de I+D: no cumplen con su deber. Si no hay patentes, no hay royalties. ¡Demonios, esto apesta!  Les daría un aumento si se espabilasen, o si pudiera permitírmelo."

[MISSION1_LINE9]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "5/5/2001"
STRING        = "Pero apenas nos quedan existencias para mantenernos a flote, e incluso aunque las vendiéramos, no conseguiríamos los royalties que necesitamos. ¡Demonios, no sé que es lo que ha ido mal! ¿Se hace una idea? He pensado que sería mejor cederle el puesto antes de tirar la  toalla. Espero que sepa lidiar con la situación mejor que yo"


[MISSION2_LINE0]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Producto: Patines"

[MISSION2_LINE1]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Nivel: Fácil"

[MISSION2_LINE2]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objetivo: Alcanzar una balanza de caja de 10.000.000$"

[MISSION2_LINE3]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Sin límite de tiempo"

[MISSION2_LINE4]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "Así que pensabas que las cosas iban mal, vaya, pues me temo que acaban de empeorar. Tu hermano pequeño, que nunca se distinguió por ser el cerebro de la familia, acaba de tener la brillante idea de dilapidar toda su herencia en una ruinosa fábrica de patines que solo genera pérdidas, antigua propiedad del estado de una inestable y reciente democracia ex soviética del bloque del este."

[MISSION2_LINE5]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "Mientras la inflación se adueña del país, una mano de obra desmoralizada y poco cualificada, que pide poco y ayuda menos, ve cómo su nivel de vida decae mientras sus colegas mejor cualificados emigran al oeste. La privatización de la banca ha dejado un agujero económico que solo la mafia se ha apresurado a llenar. Y eso no es lo peor."

[MISSION2_LINE6]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "Puede que al partido de la dictadura se le haya acabado la fiesta, pero el vasto y difícil de manejar Instituto de Gosudarstvenny de Patines ha mantenido hasta hace poco un monopolio total sobre la producción y la investigación. Todavía fuertemente subvencionado por el gobierno, se muestra comprensiblemente reacio a renunciar a dicho monopolio."

[MISSION2_LINE7]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "Y sus empleados tampoco tienen mucha prisa por causar problemas ya que la empresa, a pesar de todos los fallos, ofrece una seguridad mucho más atractiva que tu cínica marca de capitalismo occidental."

[MISSION2_LINE8]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = "Por culpa del honor de la familia tendrás que poner orden en este desbarajuste y conseguir diez millones en nombre de tu hermano. Después podrá montar la empresa emergente de Internet en Silicon Valley como le dijiste que hiciera."

[MISSION2_LINE9]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "5/5/2001"
STRING        = ""


[MISSION3_LINE0]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Producto: Androides para la ayuda del hogar"

[MISSION3_LINE1]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Nivel: Difícil"

[MISSION3_LINE2]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objetivo: Ser el último jugador superviviente y resistir tanto como sea posible."

[MISSION3_LINE3]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Sin límite de tiempo"

[MISSION3_LINE4]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "No se trata de si vas a ir a la bancarrota: lo tuyo es una causa perdida."

[MISSION3_LINE5]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "La superinflación no solo ha logrado que los precios se descontrolen, además tus inversores, antaño tan confiados y generosos, se han embarcado en una campaña para minimizar los daños."

[MISSION3_LINE6]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "Te van a chupar la sangre."

[MISSION3_LINE7]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = "Tienes que pagar multas diarias que suben constantemente. Para conservar intacta tu dignidad, has decidido ser la última compañía en coger los bártulos y largarse y resistir todo lo posible"

[MISSION3_LINE8]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = " "

[MISSION3_LINE9]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "5/5/2001"
STRING        = ""


[MISSION4_LINE0]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Producto: Patines"

[MISSION4_LINE1]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Nivel: Difícil"

[MISSION4_LINE2]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Objetivo: Tener el mayor nivel de efectivo neto cuando caiga el mercado"

[MISSION4_LINE3]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Tiempo limitado"

[MISSION4_LINE4]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = "Los mercados llevan demasiado tiempo por las nubes. Nadie, salvo los más ingenuos, podía pensar que iba a durar para siempre ¿Acaso alguien ha sabido alguna vez de una subida sin una caída?"

[MISSION4_LINE5]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = "Sin duda esta subida ha sido impresionante, y todo apunta a que la caída va a ser igualmente espectacular. Cualquier analista de medio pelo puede decírtelo."

[MISSION4_LINE6]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = "El problema es cuándo y cuánto tiempo queda para sacar tajada de lo que queda. El ganador será aquel que tenga más dinero cuando llegue la bancarrota."

[MISSION4_LINE7]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = ""

[MISSION4_LINE8]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = " "

[MISSION4_LINE9]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "5/5/2001"
STRING        = " "

[MISSION5_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Producto: Retretes"

[MISSION5_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Nivel: Fácil "

[MISSION5_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objetivo: Salir de los números rojos poniendo a 0 tu saldo final"

[MISSION5_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tiempo limitado"

[MISSION5_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Se te ha enviado a una empresa emergente agobiada por las deudas que está a punto de irse al garete. La estrategia de tu antecesor fue desastrosa."

[MISSION5_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Lo invirtió todo en investigación. Cuentas con un laboratorio que es el último grito y has investigado todas las tecnologías."

[MISSION5_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Además, tienes a tu servicio investigadores expertos que resultan carísimos."

[MISSION5_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Gastos inmensos y nula rentabilidad. Los inversores quieren que des la vuelta al lugar en el plazo de un año."

[MISSION5_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION5_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "



[MISSION6_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Producto: Patines"

[MISSION6_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Nivel: Medio"

[MISSION6_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objetivo: Lograr un saldo de caja de 2.500.000$"

[MISSION6_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tiempo ilimitado"

[MISSION6_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Llevas algún tiempo sin sobornar al Ministerio de Economía, así que el gobierno ha cumplido su amenaza: ha embargado tus productos."

[MISSION6_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "No puedes vender nada. Encima, por si esto fuera poco, tu rival está aprovechando esta magnífica oportunidad para borrarte del mapa para siempre."

[MISSION6_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "No le hace ascos a nada: el espionaje y la coacción forman parte de tu camino diario."

[MISSION6_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Y no esperes ayuda de la ley porque, en este país, los abogados son corruptos hasta la médula y, de todos modos, ninguno trabajaría para ti."

[MISSION6_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "La única forma de sobrevivir es cumplir la producción ocasional e investigar los pedidos que recibes de empresas del extranjero. Gana todo el dinero que puedas y desaparece mientras las cosas marchen."

[MISSION6_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION7_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Producto: Retretes"

[MISSION7_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Nivel: Medio "

[MISSION7_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objetivo: Lograr una valoración de producto del 60% por parte de los emotivos"

[MISSION7_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tiempo ilimitado"

[MISSION7_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Hay una fuga de talentos."

[MISSION7_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Solo te quedan técnicos. A pesar de todo, has decidido apoyar a tu empresa y medir tus fuerzas con los laboratorios de investigación secreta que cuentan con todo lo necesario."

[MISSION7_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Estás convencido de que encontrarás un mercado:"

[MISSION7_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "de ti depende que te sitúes correctamente y hagas tu agosto."

[MISSION7_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION7_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION8_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Producto: Androide de ayuda en el hogar"

[MISSION8_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Nivel: Medio"

[MISSION8_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Objetivo: Ser el último jugador superviviente"

[MISSION8_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Tiempo ilimitado"

[MISSION8_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Eres Don Limpio."


[MISSION8_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§Como eres un auténtico caballero, desprecias a tus rivales, que se han aliado para acabar con tu empresa sea como sea, y los métodos de algunos apestan."

[MISSION8_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Para no rebajarte a su nivel, decides poner el asunto en manos de los abogados y emprender reiteradas acciones legales."

[MISSION8_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "El problema es dar con el culpable porque si entablas una demanda contra un rival inocente, pierdes. Sin embargo, si pillas al culpable la multa será tan elevada que no le quedará más remedio que  rendirse."

[MISSION8_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Resiste los cobardes ataques de la competencia y consigue que los condenen uno por uno."

[MISSION8_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

