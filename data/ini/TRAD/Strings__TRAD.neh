[MISSION0_LINE0]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Toiletten"

[MISSION0_LINE1]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Niveau: Makkelijk"

[MISSION0_LINE2]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Doelstelling: Het meest geraffineerde toilet produceren"

[MISSION0_LINE3]
COMMENT       = "Description de la mission 0"
LAST_MODIFIED = "4/18/2001"
STRING        = "Onbeperkte tijd "

[MISSION0_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Geachte Heer,§§Als secretaris van de Europese Wetenschapsstichting is het mij een voorrecht u uit te nodigen deel te nemen aan de 4e Internationale Toilettenbeurs die volgend jaar rond deze tijd zal plaatsvinden in Kopenhagen."

[MISSION0_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Ik hoop oprecht dat de Fameuze Latrine Faciliteit de evolutietechnologie voor het nieuwe millennium zal zijn, zoals kernfusie dat vijftig jaar geleden was en buskruit vijfhonderd jaar geleden."

[MISSION0_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Als deelnemer aan de beurs heeft u de gelegenheid uw werk te tonen aan een jury van concullega's en het werk te aanschouwen van andere bedrijven in de branche."

[MISSION0_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Een prijs van $100,000 wordt uitgereikt voor het beste toilet, gevolgd door twee prijzen voor de tweede plaats van elk $20,000."

[MISSION0_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "We hopen u in Kopenhagen te zien,§§Hoogachtend,§§I . Asimov"

[MISSION0_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""


[MISSION1_LINE0]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Toiletten"

[MISSION1_LINE1]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Niveau: Moeilijk "

[MISSION1_LINE2]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Doelstelling: 400 Toiletten verkopen"

[MISSION1_LINE3]
COMMENT       = "Description de la mission 1"
LAST_MODIFIED = "4/18/2001"
STRING        = "Onbeperkte tijd"

[MISSION1_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Je bent een management-consultant die is gespecialiseerd in startende bedrijven en hebt een bericht op je antwoordapparaat van een toiletfabrikant die moeite heeft zijn goederen aan de man te brengen."

[MISSION1_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Kun jij hun dalende winstcurve ombuigen en doortrekken naar positieve waarden?§§“Mijn naam is dhr. Bochtig van de firma U-Bochtech en Spoeling. Misschien kent u ons nog niet, maar ik weet zeker dat u wel eens op ons heeft gezeten. Wij maken namelijk toiletten. Futuristische toiletten."

[MISSION1_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Maar de toekomst ziet er niet zo goed uit. Daarom bel ik u.§Het probleem is dat niemand onze toiletten koopt. Men geneert zich te praten over de frisse nieuwe toekomst die wij bieden, zoals verstelbare potten en medische analyses."

[MISSION1_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Kennelijk blijft men liever in de middeleeuwen van vlotters en kalkaanslag steken. Ik heb met de afdeling P&O gesproken en zij zeggen dat er ook geen technici of productiechefs zijn. De productie ligt dus bijna stil en bovendien verlangen ze dikke salarissen. Nou, ik heb dus geprobeerd te praten met P&O, maar dat heeft niet veel opgeleverd."

[MISSION1_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Ik kan eigenlijk ook niet al te best opschieten met de onderzoeks- en ontwikkelingsafdeling, zij doen hun werk niet naar behoren. Geen patenten, geen royalty's. Kortom, de sfeer hier is shit! Ik wil hun salaris wel verhogen als ze zich wat flexibeler zouden opstellen, of als ik het me kon veroorloven."

[MISSION1_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Maar we hebben nauwelijks voorraad over om in de markt te zetten en zelfs al zouden we de voorraad verkopen, dan brengt het nog niet de royalty's op die we nodig hebben. Kortom, ik weet niet wat er fout is gegaan! Heeft u nu een beetje een indruk? Ik dacht dat ik het u maar beter in handen kon geven voordat ik het helemaal opgeef. Ik hoop dat u beter bent opgewassen tegen de spanning dan ik.”"


[MISSION2_LINE0]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Rolschaatsen"

[MISSION2_LINE1]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Niveau: Makkelijk"

[MISSION2_LINE2]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Doelstelling: $10.000.000 Verdienen"

[MISSION2_LINE3]
COMMENT       = "Description de la mission 2"
LAST_MODIFIED = "4/18/2001"
STRING        = "Onbeperkte tijd"

[MISSION2_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Dus jij dacht dat het slecht ging? Ik ben bang dat het nog veel erger wordt. Je kleine broertje, toch al nooit het brein van de familie, heeft het briljante idee opgevat om zijn complete erfenis te verkwisten aan een vervallen, verliesgevende, voormalige staatsrolschaatsfabriek, in een onstabiel, ex-Sovjet Oostblokland met een prille democratie."

[MISSION2_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "De inflatie houdt het land in zijn greep, de gedemoraliseerde en onbekwame beroepsbevolking die weinig vraagt, maar nog minder bijdraagt, ziet haar levensstandaard dalen aangezien de beter gekwalificeerde tegenhangers naar het Westen trekken."

[MISSION2_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "De privatisering van het bankwezen heeft een financieel gat achtergelaten dat slechts door de maffia wordt opgevuld. En dat is nog niet het ergste. Het feest mag dan voorbij zijn voor de eenpartijstaat, maar het enorm logge Gosudarttistische Rolschaatsinstituut had tot recentelijk een totale monopoliepositie wat betreft productie en onderzoek."

[MISSION2_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Het bedrijf wordt nog steeds zwaar gesubsidieerd door de regering en is er natuurlijk niet happig op dit op te geven. Het personeel staat ook niet te trappelen om hervormingen, want de fabriek biedt ondanks alle gebreken nog altijd meer zekerheid dan het meedogenloze westerse kapitalisme."

[MISSION2_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Red de eer van de familie, schep orde in deze janboel en verdien een stevige tien miljoen namens je broer. Vervolgens kan hij dat internetbedrijf opzetten in Silicon Valley zoals je hem al aangeraden had te doen."

[MISSION2_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""



[MISSION3_LINE0]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Robot Thuishulp"

[MISSION3_LINE1]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Niveau: Moeilijk"

[MISSION3_LINE2]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Doelstelling: Als enige speler overblijven"

[MISSION3_LINE3]
COMMENT       = "Description de la mission 3"
LAST_MODIFIED = "4/18/2001"
STRING        = "Onbeperkte tijd"

[MISSION3_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "De periode van lage inflatie en fiscale beperkingen lijkt ten einde. Omdat de wereldeconomie afremt, hebben regeringen belastingen en rentetarieven verlaagd in een poging hun eigen economieën een impuls te geven."

[MISSION3_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Het inflatieniveau dat hieruit voortvloeide was echter iets dat niemand kon voorspellen. Bovendien wijst marktonderzoek uit dat een nieuw toilettentijdperk voorlopig nog niet aan zal breken. Het publiek blijft zich generen voor zijn lichaamsfuncties en geven de voorkeur aan 19e-eeuwse technologie."

[MISSION3_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Het rapport onthult ook dat preutsheid niet de enige reden is voor de neergang. Het publiek is oprecht verbijsterd over de hoeveelheid modellen die er op de markt zijn."

[MISSION3_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Dat is niet zo verwonderlijk als je bedenkt dat jij en nog zeven andere bedrijven moeten ploeteren om het hoofd boven water te houden."

[MISSION3_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "De prijzen van de producten rijzen de pan uit, waardoor er een hoop bedrijven failliet zullen gaan voordat de economie zichzelf weer heeft gereguleerd."

[MISSION3_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Kun jij de storm doorstaan en ben jij een van de bedrijven die nog steeds meedoen als de wolken zijn weggetrokken?"


[MISSION4_LINE0]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Product: Rolschaatsen"

[MISSION4_LINE1]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Niveau: Moeilijk"

[MISSION4_LINE2]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Doelstelling: Over het meeste geld beschikken als de markt instort"

[MISSION4_LINE3]
COMMENT       = "Description de la mission 4"
LAST_MODIFIED = "4/18/2001"
STRING        = "Beperkte tijd"

[MISSION4_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "De financiële markten stijgen al veel te lang. Behalve de naïefsten, weet iedereen dat dit niet zo door kan blijven gaan: geen hoogconjunctuur zonder een laagconjunctuur."

[MISSION4_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Deze hausse-bui is inderdaad zeer indrukwekkend geweest, maar alle tekenen wijzen op een baisse die niet best zal zijn. De markt staat op instorten en dit staat binnenkort te gebeuren."

[MISSION4_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "Elke onbenullige analist kan je dat vertellen. Het probleem is alleen: wanneer? Hoeveel tijd is er nog om je winst te nemen?"

[MISSION4_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = "De winnaar in dit spel is degene die het meeste geld heeft als de markt ineen stort.""

[MISSION4_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""

[MISSION4_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "5/5/2001"
STRING        = ""


[MISSION5_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Toiletten"

[MISSION5_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Niveau: Makkelijk"

[MISSION5_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Doelstelling: Uit de rode cijfers komen door je saldo naar 0 te brengen"

[MISSION5_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Beperkte tijd"

[MISSION5_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Je bent naar een startend bedrijf gestuurd dat op het punt staat failliet te gaan en diep in de schulden zit."

[MISSION5_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "De strategie van je voorganger was rampzalig. Hij investeerde alles in onderzoek."

[MISSION5_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Je hebt een supermodern lab en er is onderzoek gedaan naar elke technologie."

[MISSION5_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Je hebt specialistische onderzoekers in dienst die erg duur zijn. Enorme uitgaven en geen winst. De investeerders willen dat je de situatie binnen een jaar verandert. "

[MISSION5_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION5_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "



[MISSION6_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Rolschaatsen"

[MISSION6_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Niveau: Gemiddeld"

[MISSION6_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Doelstelling: $2.500.000 Verdienen"

[MISSION6_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Onbeperkte tijd"

[MISSION6_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Je hebt geen smeergeld aan het Ministerie van Financiën betaald en nu heeft de regering zijn dreigement uitgevoerd: een productembargo. Je mag niets meer verkopen."

[MISSION6_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Om het allemaal nog erger te maken, grijpt je rivaal deze prachtige gelegenheid aan om je compleet te ruïneren. Niets is te smerig voor hem: spionage en intimidatie zijn aan de orde van de dag."

[MISSION6_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Reken er maar niet op dat het rechtssysteem je zal helpen, want in dit land zijn de advocaten door en door corrupt en wil sowieso niemand voor je werken."

[MISSION6_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§De enige manier om te overleven is om de productie- en onderzoeksorders uit te voeren die je af en toe van buitenlandse bedrijven krijgt. Probeer zoveel mogelijk geld te verdienen en maak dat je wegkomt zolang het nog goed gaat."

[MISSION6_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION6_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION7_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Toiletten"

[MISSION7_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Niveau: Gemiddeld"

[MISSION7_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Doelstelling: Bereik een productwaardering van 60% onder designfreaks"

[MISSION7_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Onbeperkte tijd"

[MISSION7_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Er zijn een heleboel specialisten vertrokken. Je hebt alleen nog technici over."

[MISSION7_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Ondanks alles heb je besloten om bij het bedrijf te blijven en te concurreren met geheime onderzoekslaboratoria die alle benodigde hulpmiddelen hebben."

[MISSION7_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Je bent ervan overtuigd dat je een markt kunt vinden:"

[MISSION7_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "het is aan jou om het bedrijf op de juiste manier te positioneren en een klapper te maken."

[MISSION7_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION7_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "


[MISSION8_LINE0]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Product: Robot Thuishulp"

[MISSION8_LINE1]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Niveau: Gemiddeld"

[MISSION8_LINE2]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Doelstelling: Als enige speler overblijven"

[MISSION8_LINE3]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Onbeperkte tijd"

[MISSION8_LINE4]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Jij bent Meneer Correct."

[MISSION8_LINE5]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "§Aangezien jij een echte heer bent, heb je een hekel aan je rivalen die hun krachten hebben gebundeld om je bedrijf met alle, merendeels smerige, middelen te gronde te richten."

[MISSION8_LINE6]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Je wilt je niet verlagen tot hun niveau en besluit daarom advocaten in de arm te nemen en voortdurend rechtszaken aan te spannen. Het probleem is om de schuldige partij aan te wijzen, want je zult de rechtszaak verliezen als je een onschuldige rivaal voor het gerecht sleept."

[MISSION8_LINE7]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = "Als je de boosdoener echter te pakken weet te krijgen, zal de schadevergoeding zo hoog zijn dat hij wel gedwongen wordt zich gewonnen te geven. Hou je staande onder de lafhartige aanvallen van de concurrentie en zorg ervoor dat ze één voor één worden veroordeeld."

[MISSION8_LINE8]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

[MISSION8_LINE9]
COMMENT       = "Description de la mission"
LAST_MODIFIED = "6/13/2001"
STRING        = " "

