LAST_FRAME=200
STRING="Leg los, hau rein,"

[1]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=210
LAST_FRAME=300
STRING="Und lass die Uni Uni sein,"

[2]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=350
LAST_FRAME=500
STRING="Zieh dein Leben aus dem Sumpf, wo die Noten dich versenken."

[3]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=550
LAST_FRAME=700
STRING="Vier Jahre lang hast du's vermasselt, zu viel gesoffen, zu viel gequasselt."

[4]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=750
LAST_FRAME=900
STRING="Statt an Dante und Descartes zu denken."

[5]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=950
LAST_FRAME=1000
STRING="Jetzt musst du dich wohl selber retten."

[6]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1050
LAST_FRAME=1110
STRING="Du hast den Plan, das Produkt, ja ein Projekt?"

[7]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1120
LAST_FRAME=1200
STRING="Vielleicht ist's Mist, doch so lang das keiner checkt,"

[8]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1201
LAST_FRAME=1280
STRING="Verkauf Roboter, Rollschuh, Fernseher und Toiletten."

[9]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1280
LAST_FRAME=1345
STRING="Und droht dann mal dein Gewissen zu erweichen,"

[10]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1350
LAST_FRAME=1400
STRING="So ist selbst das ein wundervolles Zeichen."

[11]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1401
LAST_FRAME=1470
STRING="An der Uni kriegst du stets naiv-gelehrte Deppen"

[12]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1475
LAST_FRAME=1550
STRING="Die kannst du für dein vieles Wissen mit noch weniger entlohnen."

[13]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1551
LAST_FRAME=1650
STRING="Werden die dann wirklich mürrisch und wollen mehr"

[14]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1651
LAST_FRAME=1700
STRING="Gib halt Aktienoptionen"

[15]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1701
LAST_FRAME=1760
STRING="Für dein neues Unternehmen her."

[16]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1761
LAST_FRAME=1840
STRING="Plag dann die Investoren und lade sie fein"

[17]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1841
LAST_FRAME=1910
STRING="Zur Party in die Firma ein."

[18]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=1911
LAST_FRAME=2000
STRING="Frag deine Familie, Freunde, Finanz- und Mafiavertreter."

[19]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=2001
LAST_FRAME=2070
STRING="Tu alles, werde zum Verräter"

[20]
LAST_MODIFIED="1/10/2000"
FIRST_FRAME=2071
LAST_FRAME=2150
STRING="Um von ihnen allen Geld zu borgen."
